# Database: DATABASE_URL (owner) hanya untuk scripts/; API memakai AI_EXECUTOR_DATABASE_URL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ta_umkm
AI_EXECUTOR_DATABASE_URL=postgresql+asyncpg://readonly_ai_executor:ganti_password@localhost:5432/ta_umkm
DB_STATEMENT_TIMEOUT_MS=5000

# LLM API Keys
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# LLM (kunci model dari app/services/model_registry.py, dipisah koma)
LLM_MODELS=llama-3.3-70b,qwen3.8-27b,gpt-oss-120b
LLM_TIMEOUT_S=30
DEFAULT_PROMPT_STRATEGY=few_shot

# Study area
STUDY_AREA_NAME=Kota Depok, Jawa Barat
STUDY_AREA_REGENCY_ID=3276
DEFAULT_CENTER_LAT=-6.36043
DEFAULT_CENTER_LON=106.83178
DEFAULT_RADIUS_M=500

# API (kosongkan API_KEY untuk menonaktifkan autentikasi)
API_KEY=
RATE_LIMIT_PER_MINUTE=30
EXPERIMENT_LOG_PATH=logs/requests.jsonl
BACKEND_API_URL=http://localhost:8000
APP_ENV=development
